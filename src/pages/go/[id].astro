---
import { TOOLS } from "@/data/tools";

export async function getStaticPaths() {
  return TOOLS.map(tool => ({
    params: { id: tool.id },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const destination = tool.affiliateUrl ?? tool.officialUrl;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting to {tool.name}...</title>
    <meta http-equiv="refresh" content={`1; url=${destination}`} />
    <meta name="robots" content="noindex,nofollow" />
    <script is:inline define:vars={{ url: destination, slug: tool.id }}>
      // go_redirect 計測は gtag.js に依存せず GA4 収集エンドポイントへ sendBeacon で直送する。
      // 旧実装（gtag.js async ロード＋400ms 強制遷移）はコールド流入で gtag.js のロードが
      // 間に合わず、実クリックの約94%が未計測だった（2026-07-30 GA4 API vs ASP 実測で特定）。
      // sendBeacon はページ遷移後も送信が生きるため、計測と遷移が競合しない。
      try {
        var m = document.cookie.match(/_ga=GA\d+\.\d+\.(\d+\.\d+)/);
        var cid = m
          ? m[1]
          : Math.floor(Math.random() * 1e9) + "." + Math.floor(Date.now() / 1000);
        var p = new URLSearchParams({
          v: "2",
          tid: "G-S55TTRMBX0",
          cid: cid,
          en: "go_redirect",
          "ep.link_slug": slug,
          "ep.link_domain": new URL(url).hostname,
          "ep.page_path": location.pathname,
          "ep.referrer": document.referrer || "(direct)",
        });
        navigator.sendBeacon(
          "https://www.google-analytics.com/g/collect?" + p.toString()
        );
      } catch (e) {}
      window.location.replace(url);
    </script>
    <style is:inline>
      body {
        font-family: system-ui, sans-serif;
        max-width: 480px;
        margin: 80px auto;
        padding: 0 20px;
        text-align: center;
        line-height: 1.6;
        color: #1b1a17;
        background: #f7f5f0;
      }
      a {
        color: #d9422a;
      }
    </style>
  </head>
  <body>
    <p>{tool.name} へリダイレクト中…</p>
    <p>自動的に遷移しない場合は <a href={destination}>こちら</a> をクリックしてください。</p>
  </body>
</html>
